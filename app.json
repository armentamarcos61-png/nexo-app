{
  "expo": {
    "name": "Nexo",
    "slug": "nexo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nexo-logo.png",
    "scheme": "nexoapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/nexo-logo.png",
        "backgroundColor": "#0B0E13"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nexo-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15181D",
          "image": "./assets/images/nexo-logo.png",
          "imageWidth": 110
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
